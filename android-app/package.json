{
  "name": "ma-cave-android",
  "version": "0.1.0",
  "private": true,
  "description": "Appli Android de Ma cave : le fichier index.html du dossier parent, embarqué avec Capacitor.",
  "scripts": {
    "web": "node scripts/copy-web.js",
    "sync": "npm run web && npx cap sync android",
    "open": "npx cap open android",
    "apk": "node scripts/apk.js maison",
    "install-phone": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe\" install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "phones": "\"%LOCALAPPDATA%\\Android\\Sdk\\platform-tools\\adb.exe\" devices -l",
    "apk:generique": "node scripts/apk.js generique",
    "web:generique": "node scripts/copy-web.js --generique"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
}
